// Cloudflare Workers static assets: the static export in out/ is the whole site.
// Deploy: pnpm run deploy:cloudflare (needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID, byokapi.com account).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "muxpilot",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Only the custom domain serves the site; no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "muxpilot.byokapi.com", "custom_domain": true }]
}
